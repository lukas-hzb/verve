# Flask
SECRET_KEY=generate-a-long-random-value
FLASK_CONFIG=development

# Neon Postgres
# Use the pooled URL for deployed/serverless app traffic and sslmode=require.
SQLALCHEMY_DATABASE_URI=postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional direct Google OpenID Connect login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development server
FLASK_HOST=127.0.0.1
FLASK_PORT=8080
